{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/_fragments/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/exhibitions/exhibitions-overview",
      "destination": "/exhibitions/overview",
      "permanent": true
    },
    {
      "source": "/research/research-overview",
      "destination": "/research/overview",
      "permanent": true
    },
    {
      "source": "/research/research-bdss",
      "destination": "/research/bdss",
      "permanent": true
    },
    {
      "source": "/research/research-rcs",
      "destination": "/research/rcs",
      "permanent": true
    },
    {
      "source": "/research/isea-2026",
      "destination": "/research/overview",
      "permanent": true
    },
    {
      "source": "/research/research-isea",
      "destination": "/research/overview",
      "permanent": true
    }
  ]
}
